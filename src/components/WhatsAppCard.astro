---
/*
 * L'étape « rejoins le groupe WhatsApp », proposée juste après l'inscription.
 * Reprise de la page /merci de Free Formation (carte verte qui pulse, bouton
 * WhatsApp), relue dans la DA de la page. Rendue seulement si LIVE.WHATSAPP_URL
 * est renseignée.
 */
import { LIVE } from '../config/live';

interface Props {
	titre?: string;
	texte?: string;
	compact?: boolean;
}
const {
	titre = 'Rejoins le groupe WhatsApp du live',
	texte = "C'est là que tout se passe avant le live : le lien de connexion, le rappel, les questions des autres participants et les retours de Lucas après chaque session.",
	compact = false
} = Astro.props;
---

{
	LIVE.WHATSAPP_URL && (
		<div class:list={['whatsapp', { compact }]}>
			<span class="wa-icone" aria-hidden="true">
				<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
				</svg>
			</span>
			<h3 class="wa-titre">{titre}</h3>
			<p class="wa-texte">{texte}</p>
			<a class="cta wa-bouton" href={LIVE.WHATSAPP_URL} target="_blank" rel="noopener" data-whatsapp>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
				</svg>
				Rejoindre le groupe WhatsApp
			</a>
			<small>Groupe privé, réservé aux inscrits. Tu peux le quitter à tout moment.</small>
		</div>
	)
}

<style>
	.whatsapp {
		--wa: #25d366;
		text-align: center;
		padding: 30px 26px 26px;
		margin: 0 auto 26px;
		background: linear-gradient(160deg, rgba(37, 211, 102, 0.12) 0%, rgba(37, 211, 102, 0.04) 100%);
		border: 1px solid rgba(37, 211, 102, 0.38);
		border-radius: 20px;
		animation: pulse-wa 2.4s ease-in-out infinite;
	}
	@keyframes pulse-wa {
		0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.18); }
		50% { box-shadow: 0 0 26px 6px rgba(37, 211, 102, 0.1); }
	}
	.wa-icone {
		display: inline-grid;
		place-items: center;
		width: 54px; height: 54px;
		border-radius: 50%;
		color: var(--wa);
		background: rgba(37, 211, 102, 0.12);
		border: 1px solid rgba(37, 211, 102, 0.35);
		margin-bottom: 14px;
	}
	.whatsapp h3.wa-titre {
		font-family: var(--display);
		font-weight: 400;
		font-size: 27px;
		text-transform: none;
		letter-spacing: normal;
		line-height: 1.1;
		color: var(--creme);
		margin-bottom: 10px;
	}
	.whatsapp p.wa-texte {
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--muet);
		max-width: 420px;
		margin: 0 auto 20px;
	}
	.whatsapp a.wa-bouton {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--wa);
		color: #052e16;
		padding: 17px 28px;
		box-shadow: 0 14px 34px rgba(37, 211, 102, 0.28);
	}
	.whatsapp a.wa-bouton:hover {
		background: #3ee07a;
		box-shadow: 0 18px 44px rgba(37, 211, 102, 0.36);
	}
	.whatsapp small {
		display: block;
		margin-top: 14px;
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.08em;
		color: var(--muet-2);
	}

	.compact { padding: 22px 18px 20px; margin-bottom: 0; animation: none; }
	.compact .wa-icone { width: 44px; height: 44px; margin-bottom: 10px; }
	.compact h3.wa-titre { font-size: 23px; }
	.compact p.wa-texte { font-size: 13.5px; margin-bottom: 16px; }
	.compact .wa-bouton { padding: 15px 22px; }

	@media (prefers-reduced-motion: reduce) { .whatsapp { animation: none; } }
</style>
